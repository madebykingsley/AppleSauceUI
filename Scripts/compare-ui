#!/bin/zsh

set -euo pipefail

fail() {
    print -u2 -- "Error: $1"
    exit 1
}

if [[ $# -ne 1 ]]; then
    fail "Usage: Scripts/compare-ui <target> (for example: media/apple-music/home)"
fi

target="${1:l}"
if [[ "$target" == /* || "$target" == */ || "$target" == *//* || ! "$target" =~ '^[a-z0-9]+(-[a-z0-9]+)*(\/[a-z0-9]+(-[a-z0-9]+)*)*$' ]]; then
    fail "Target must contain lowercase kebab-case path components, such as media/apple-music/home."
fi

script_dir="${0:A:h}"
project_root="${script_dir:h}"

semantic_path=""
for segment in ${(s:/:)target}; do
    semantic_segment=""
    for word in ${(s:-:)segment}; do
        semantic_segment+="${(C)word}"
    done
    semantic_path+="${semantic_path:+/}${semantic_segment}"
done

screen_name="${target:t}"
reference_directory="AppleSauceUI/Lab/References/${semantic_path}"
target_name="${target//\//-}"
reference_relative=""
metadata_relative=""
for resource_name in "${target_name}-reference" "${screen_name}-reference" "reference"; do
    candidate_relative="${reference_directory}/${resource_name}.png"
    if [[ -f "${project_root}/${candidate_relative}" ]]; then
        reference_relative="$candidate_relative"
        metadata_relative="${reference_directory}/${resource_name}.json"
        break
    fi
done

[[ -n "$reference_relative" ]] || fail "Reference not found. Expected ${target_name}-reference.png, ${screen_name}-reference.png, or reference.png in ${reference_directory}."
reference_path="${project_root}/${reference_relative}"
metadata_path="${project_root}/${metadata_relative}"

if ! simulator_output="$(xcrun simctl list devices booted 2>&1)"; then
    fail "Could not query Simulator devices. Verify Xcode and CoreSimulator are available."
fi
simulator_matches="$(print -r -- "$simulator_output" | awk '/iPhone/ && /\(Booted\)/ { print }')"
[[ -n "$simulator_matches" ]] || fail "No booted iPhone Simulator found. Boot the expected simulator and run the app first."
simulator_lines=("${(@f)simulator_matches}")
if (( ${#simulator_lines} > 1 )); then
    print -u2 -- "Error: Multiple booted iPhone Simulators found:"
    for line in "${simulator_lines[@]}"; do
        print -u2 -- "  ${(j: :)${(z)line}}"
    done
    fail "Shut down the simulators you do not intend to capture."
fi

simulator_line="${simulator_lines[1]}"
simulator_udid="$(print -r -- "$simulator_line" | sed -E 's/^.*\(([0-9A-Fa-f-]{36})\).*$/\1/')"
[[ "$simulator_udid" =~ '^[0-9A-Fa-f-]{36}$' ]] || fail "Could not determine the booted simulator identifier."
simulator_name="$(print -r -- "$simulator_line" | sed -E 's/^[[:space:]]*//; s/[[:space:]]+\([0-9A-Fa-f-]{36}\)[[:space:]]+\(Booted\).*$//')"

metadata_name=""
metadata_device=""
metadata_conditions=()
if [[ -f "$metadata_path" ]]; then
    metadata_name="$(/usr/bin/plutil -extract name raw -o - "$metadata_path" 2>/dev/null || true)"
    metadata_device="$(/usr/bin/plutil -extract device raw -o - "$metadata_path" 2>/dev/null || true)"
    if [[ -n "$metadata_device" && "$metadata_device" != "$simulator_name" ]]; then
        fail "Reference expects '${metadata_device}', but the booted simulator is '${simulator_name}'."
    fi
    for key in platform os orientation appearance dynamicType; do
        value="$(/usr/bin/plutil -extract "$key" raw -o - "$metadata_path" 2>/dev/null || true)"
        if [[ -n "$value" ]]; then
            metadata_conditions+=("$value")
        fi
    done
fi

output_relative="Artifacts/VisualComparisons/${target}"
output_path="${project_root}/${output_relative}"
staging_path="$(mktemp -d "${TMPDIR:-/tmp}/applesauce-compare.XXXXXX")"
trap 'rm -rf -- "$staging_path"' EXIT

actual_path="${staging_path}/actual.png"
if ! xcrun simctl io "$simulator_udid" screenshot --type=png "$actual_path" >/dev/null; then
    fail "Simulator screenshot capture failed."
fi
[[ -s "$actual_path" ]] || fail "Simulator screenshot capture did not produce an image."

cp -p "$reference_path" "${staging_path}/reference.png"
dimensions="$(xcrun swift -module-cache-path "${staging_path}/module-cache" \
    "${script_dir}/VisualComparisonImageTool.swift" \
    "${staging_path}/reference.png" \
    "$actual_path" \
    "${staging_path}/overlay-50.png" \
    "${staging_path}/diff.png")" || exit $?

mkdir -p "$output_path"
for artifact in reference.png actual.png overlay-50.png diff.png; do
    mv -f "${staging_path}/${artifact}" "${output_path}/${artifact}"
done

print -- "AppleSauceUI Visual Comparison"
print
printf "%-12s %s\n" "Target:" "$target"
printf "%-12s %s\n" "Reference:" "$reference_relative"
printf "%-12s %s\n" "Simulator:" "$simulator_name"
printf "%-12s %s\n" "Dimensions:" "${dimensions/x/ × }"
if [[ -f "$metadata_path" ]]; then
    printf "%-12s %s\n" "Metadata:" "$metadata_relative"
    if [[ -n "$metadata_name" ]]; then
        printf "%-12s %s\n" "Fixture:" "$metadata_name"
    fi
    if (( ${#metadata_conditions} > 0 )); then
        printf "%-12s %s\n" "Conditions:" "${(j: · :)metadata_conditions}"
    fi
fi
print
print -- "✓ reference.png"
print -- "✓ actual.png"
print -- "✓ overlay-50.png"
print -- "✓ diff.png"
print
print -- "Output:"
print -- "${output_relative}/"
